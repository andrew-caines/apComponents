{
  "name": "ap-showcase",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "serve": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "test:smoke": "playwright test e2e/smoke.spec.ts"
  },
  "dependencies": {
    "@ap/react": "file:../packages/react",
    "@ap/vite": "file:../packages/vite",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.1",
    "@react-router/node": "^8.3.1",
    "@react-router/serve": "^8.3.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  }
}
