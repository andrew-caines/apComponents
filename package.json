{
  "name": "apcomponents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:tokens": "vitest run packages/tokens/src/gates/determinism.gate.test.ts",
    "test:contrast": "vitest run packages/tokens/src/gates/contrast.gate.test.ts",
    "test:gamut": "vitest run packages/tokens/src/gates/gamut.gate.test.ts",
    "test:sweep": "vitest run packages/tokens/src/gates/sweep.gate.test.ts",
    "test:contract": "vitest run packages/react/src/gates/contract-drift.gate.test.ts",
    "test:freshness": "vitest run packages/react/src/gates/theme-freshness.gate.test.ts",
    "test:fonts": "vitest run packages/react/src/gates/fonts.gate.test.ts",
    "test:guards": "vitest run packages/react/src/gates/use-client.gate.test.ts packages/react/src/gates/ssr-safety.gate.test.ts packages/react/src/gates/style-rules.gate.test.ts packages/react/src/gates/base-ui-imports.gate.test.ts packages/react/src/gates/no-hardcoded-strings.gate.test.ts packages/react/src/gates/examples-freshness.gate.test.ts",
    "test:gates": "npm run test:tokens && npm run test:contrast && npm run test:gamut && npm run test:sweep && npm run test:contract && npm run test:freshness && npm run test:fonts && npm run test:guards && npm run test:motion",
    "fixture:install": "npm --prefix fixtures/ssr-app install && npm --prefix fixtures/consumer install",
    "showcase:install": "npm --prefix showcase install",
    "showcase": "npm --prefix showcase run serve",
    "showcase:build": "npm --prefix showcase run build",
    "showcase:test": "npm --prefix showcase run test:e2e",
    "test:a11y": "npm --prefix showcase run test:a11y",
    "test:ssr": "vitest run --config vitest.gates.config.ts packages/react/src/gates/ssr-render.gate.test.ts",
    "test:consumer": "vitest run --config vitest.gates.config.ts packages/react/src/gates/consumer-build.gate.test.ts",
    "test:spa": "vitest run --config vitest.gates.config.ts packages/react/src/gates/ssr-render.gate.test.ts -t \"gate 7\"",
    "test:hydration": "npm --prefix fixtures/ssr-app run test:e2e",
    "typecheck": "tsc -b packages/tokens packages/motion packages/react packages/vite",
    "report:contrast": "tsx scripts/contrast-report.ts",
    "gen:font-metrics": "tsx scripts/gen-font-metrics.ts",
    "gen:fonts": "tsx scripts/gen-fonts.ts",
    "gen:theme-contract": "tsx scripts/gen-theme-contract.ts",
    "gen:theme-css": "tsx scripts/gen-theme-css.ts",
    "gen:motion-css": "tsx scripts/gen-motion-css.ts",
    "gen:scale-demo": "tsx scripts/gen-scale-demo.ts",
    "gen:colour-demo": "tsx scripts/gen-colour-demo.ts",
    "test:motion": "vitest run packages/motion/src",
    "gen:input-demo": "tsx scripts/gen-input-demo.ts"
  },
  "devDependencies": {
    "@capsizecss/core": "^4.1.2",
    "@capsizecss/metrics": "^3.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
